# Copy this to .env and fill in your values
# See README.md for step-by-step instructions on getting each key

# ── Candidate profile ─────────────────────────────────────────────────────────
CANDIDATE_FIRST_NAME=Your
CANDIDATE_MIDDLE_NAME=Middle
CANDIDATE_LAST_NAME=Name
CANDIDATE_EMAIL=your.email@gmail.com
CANDIDATE_PHONE=9999999999
CANDIDATE_PHONE_E164=+919999999999
CANDIDATE_LINKEDIN=https://www.linkedin.com/in/your-profile/
CANDIDATE_GITHUB=https://github.com/yourhandle
CANDIDATE_ADDRESS=Your Street Address
CANDIDATE_CITY=Bengaluru
CANDIDATE_STATE=Karnataka
CANDIDATE_POSTAL_CODE=560001
CANDIDATE_COUNTRY=India
CANDIDATE_RESUME_PDF=~/path/to/your/resume.pdf
CANDIDATE_CURRENT_CTC=XX LPA
CANDIDATE_EXPECTED_CTC=XX LPA
CANDIDATE_NOTICE_PERIOD=1 month
CANDIDATE_ORG=Your Current Company
CANDIDATE_LOCATION=Bengaluru, India
CANDIDATE_PROFILE_SLUG=your-name-slug   # e.g. john-doe

# Workday ATS account passwords (set once when you create accounts on each portal)
WORKDAY_DEFAULT_PASSWORD=your_workday_password_here
WORKDAY_MS_PASSWORD=your_morgan_stanley_workday_password_here
WORKDAY_RH_PASSWORD=your_redhat_workday_password_here
EIGHTFOLD_PASSWORDS=password1,password2   # comma-separated, tried in order

RAPIDAPI_KEY=your_rapidapi_key_here

# ── LLM keys (auto-rotation: when one hits daily limit, next is used automatically) ──
# Priority: Groq → Ollama → DeepSeek → Mistral → OpenRouter → Gemini

GROQ_API_KEY=your_groq_api_key_here   # Free 100K/day  — console.groq.com
GROQ_API_KEY_2=                       # 2nd Groq key (another free account)
GROQ_API_KEY_3=                       # 3rd Groq key

# LOCAL model via Ollama — completely free, no internet, no daily limits
# Install: https://ollama.com  then run: ollama pull llama3.1:8b
# Recommended models: llama3.1:8b (4GB) or qwen2.5:7b (4GB)
OLLAMA_MODEL=

# Works in India — free credits on signup
# Get key: https://platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=

# Works in India — free credits on signup
# Get key: https://console.mistral.ai → API Keys
MISTRAL_API_KEY=

# Works in India — FREE models (no credits needed, just sign up)
# Get key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# May need VPN in India — 1M tokens/day free
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gmail credentials
GMAIL_ADDRESS=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
DIGEST_RECIPIENT=your.email@gmail.com
